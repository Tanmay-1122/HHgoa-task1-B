# Populated automatically when you add the Vercel Postgres integration
# in the Vercel dashboard (Project -> Storage -> Create Database -> Postgres).
# Locally, run `vercel env pull .env.local` after adding it, instead of typing these by hand.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Populated automatically when you add the Vercel Blob integration
# (Project -> Storage -> Create Database -> Blob).
BLOB_READ_WRITE_TOKEN=

# Optional: only needed if you're on a custom domain and want QR/OG URLs to
# use it instead of the auto-detected Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=
